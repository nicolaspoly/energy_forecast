    {
      "name": "94d8a114",
      "displayName": "load_shap_gold",
      "config": {
        "version": "1.1",
        "source": "workspace.energy_forecast.load_shap_gold",
        "dimensions": [
          {
            "name": "zone",
            "expr": "zone"
          },
          {
            "name": "target_datetime",
            "expr": "target_datetime"
          },
          {
            "name": "feature_name",
            "expr": "feature_name"
          }
        ],
        "measures": [
          {
            "name": "shap_value",
            "expr": "SUM(shap_value)"
          },
          {
            "name": "base_value",
            "expr": "MAX(base_value)"
          }
        ]
      }
    },
    {
      "name": "combined_forecast_shap",
      "displayName": "combined_forecast_shap",
      "queryLines": [
        "SELECT\n",
        "  zone,\n",
        "  target_datetime,\n",
        "  predicted_demand_mw,\n",
        "  CAST(NULL AS STRING) AS feature_name,\n",
        "  CAST(NULL AS DOUBLE) AS shap_value\n",
        "FROM\n",
        "  workspace.energy_forecast.load_forecast_gold\n",
        "UNION ALL\n",
        "SELECT\n",
        "  zone,\n",
        "  target_datetime,\n",
        "  CAST(NULL AS DOUBLE) AS predicted_demand_mw,\n",
        "  feature_name,\n",
        "  shap_value\n",
        "FROM\n",
        "  workspace.energy_forecast.load_shap_gold"
      ]
    }
  ],
